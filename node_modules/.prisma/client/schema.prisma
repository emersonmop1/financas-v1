generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts    Account[]
  categories  Category[]
  goals       Goal[]
  creditCards CreditCard[]
  imports     Import[]
  invoices    Invoice[]
  piggyBanks  PiggyBank[]
  investments Investment[]
  budgets     Budget[]

  @@map("users")
}

enum AccountType {
  CHECKING
  SAVINGS
  INVESTMENT
  CASH

  @@map("account_type")
}

model Account {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  name      String
  type      AccountType
  balance   Decimal     @default(0) @db.Decimal(15, 2)
  currency  String      @default("BRL")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("accounts")
}

enum CategoryType {
  INCOME
  EXPENSE

  @@map("category_type")
}

model Category {
  id        String       @id @default(uuid())
  userId    String?      @map("user_id")
  name      String
  type      CategoryType
  color     String       @default("#3B82F6")
  icon      String       @default("💰")
  isDefault Boolean      @default(false) @map("is_default")
  createdAt DateTime     @default(now()) @map("created_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  goals        Goal[]
  budgets      Budget[]

  @@map("categories")
}

enum TransactionType {
  INCOME
  EXPENSE

  @@map("transaction_type")
}

model Transaction {
  id               String          @id @default(uuid())
  accountId        String?         @map("account_id")
  categoryId       String          @map("category_id")
  creditCardId     String?         @map("credit_card_id")
  invoiceId        String?         @map("invoice_id")
  description      String
  amount           Decimal         @db.Decimal(15, 2)
  date             DateTime
  type             TransactionType
  isPaid           Boolean         @default(true) @map("is_paid")
  installments     Int?
  installmentNum   Int?            @map("installment_num")
  isInternational  Boolean         @default(false) @map("is_international")
  originalCurrency String?         @map("original_currency")
  originalAmount   Decimal?        @map("original_amount") @db.Decimal(15, 2)
  notes            String?
  tags             String[]        @default([])
  isReconciled     Boolean         @default(false) @map("is_reconciled")
  bankReference    String?         @map("bank_reference")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  account    Account?    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category   Category    @relation(fields: [categoryId], references: [id])
  creditCard CreditCard? @relation(fields: [creditCardId], references: [id])
  invoice    Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([creditCardId, date, type])
  @@index([accountId, date])
  @@index([accountId, type, isPaid, date])
  @@index([categoryId])
  @@index([categoryId, type, date])
  @@index([date])
  @@index([type, isPaid])
  @@map("transactions")
}

model CreditCard {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  name            String
  limit           Decimal  @db.Decimal(15, 2)
  closingDay      Int      @map("closing_day")
  dueDay          Int      @map("due_day")
  cardNumberLast4 String?  @map("card_number_last4")
  cardholderName  String?  @map("cardholder_name")
  cardBrand       String?  @map("card_brand")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  invoices     Invoice[]

  @@index([userId])
  @@map("credit_cards")
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("goal_status")
}

enum GoalType {
  SAVINGS // Meta de economia (juntar X reais)
  CATEGORY_LIMIT // Meta de gastos por categoria
  BALANCE_TARGET // Meta de saldo total
  EXPENSE_REDUCTION // Meta de redução de gastos

  @@map("goal_type")
}

enum GoalPeriod {
  MONTHLY
  YEARLY
  CUSTOM

  @@map("goal_period")
}

model Goal {
  id            String     @id @default(uuid())
  userId        String     @map("user_id")
  type          GoalType   @default(SAVINGS)
  name          String
  description   String?
  targetAmount  Decimal    @map("target_amount") @db.Decimal(15, 2)
  currentAmount Decimal    @default(0) @map("current_amount") @db.Decimal(15, 2)
  categoryId    String?    @map("category_id") // Para metas de categoria
  period        GoalPeriod @default(CUSTOM)
  startDate     DateTime?  @map("start_date")
  deadline      DateTime?
  status        GoalStatus @default(ACTIVE)
  icon          String     @default("🎯")
  color         String     @default("#3B82F6")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@map("goals")
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("import_status")
}

model Import {
  id           String       @id @default(uuid())
  userId       String       @map("user_id")
  filename     String
  status       ImportStatus @default(PENDING)
  rowsImported Int          @default(0) @map("rows_imported")
  errorMessage String?      @map("error_message")
  processedAt  DateTime?    @map("processed_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("imports")
}

model Invoice {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  creditCardId   String   @map("credit_card_id")
  statementMonth Int      @map("statement_month")
  statementYear  Int      @map("statement_year")
  closingDate    DateTime @map("closing_date")
  dueDate        DateTime @map("due_date")
  totalAmount    Decimal  @map("total_amount") @db.Decimal(15, 2)
  importedAt     DateTime @default(now()) @map("imported_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCard   CreditCard    @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, creditCardId, statementMonth, statementYear])
  @@map("invoices")
}

enum PiggyBankStatus {
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("piggy_bank_status")
}

model PiggyBank {
  id            String          @id @default(uuid())
  userId        String          @map("user_id")
  name          String
  description   String?
  targetAmount  Decimal?        @map("target_amount") @db.Decimal(15, 2)
  currentAmount Decimal         @default(0) @map("current_amount") @db.Decimal(15, 2)
  icon          String          @default("🐷")
  color         String          @default("#EC4899")
  status        PiggyBankStatus @default(ACTIVE)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions PiggyBankTransaction[]

  @@map("piggy_banks")
}

enum PiggyBankTransactionType {
  DEPOSIT
  WITHDRAWAL

  @@map("piggy_bank_transaction_type")
}

model PiggyBankTransaction {
  id          String                   @id @default(uuid())
  piggyBankId String                   @map("piggy_bank_id")
  amount      Decimal                  @db.Decimal(15, 2)
  type        PiggyBankTransactionType
  description String?
  date        DateTime                 @default(now())
  createdAt   DateTime                 @default(now()) @map("created_at")

  piggyBank PiggyBank @relation(fields: [piggyBankId], references: [id], onDelete: Cascade)

  @@map("piggy_bank_transactions")
}

enum InvestmentType {
  STOCK // Ações
  FUND // Fundos
  FIXED_INCOME // Renda Fixa
  CRYPTO // Criptomoedas
  REAL_ESTATE // Imóveis
  OTHER // Outros

  @@map("investment_type")
}

enum InvestmentStatus {
  ACTIVE
  SOLD
  CANCELLED

  @@map("investment_status")
}

model Investment {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  type          InvestmentType
  name          String
  description   String?
  ticker        String? // Código do ativo (ex: PETR4, BTC)
  quantity      Decimal          @db.Decimal(15, 8)
  purchasePrice Decimal          @map("purchase_price") @db.Decimal(15, 2)
  currentPrice  Decimal?         @map("current_price") @db.Decimal(15, 2)
  purchaseDate  DateTime         @map("purchase_date")
  saleDate      DateTime?        @map("sale_date")
  salePrice     Decimal?         @map("sale_price") @db.Decimal(15, 2)
  broker        String? // Corretora
  notes         String?
  status        InvestmentStatus @default(ACTIVE)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("investments")
}

// Orçamento mensal por categoria
model Budget {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  categoryId String   @map("category_id")
  amount     Decimal  @db.Decimal(15, 2)
  month      Int // 1-12
  year       Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
  @@index([userId, month, year])
  @@map("budgets")
}
